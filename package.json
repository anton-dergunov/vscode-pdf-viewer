{
  "name": "vscode-pdf-viewer",
  "displayName": "PDF Viewer",
  "description": "A minimal PDF viewer for VS Code: highlights saved into the PDF, search, and links that open a paper at a section, table or page, including from the Claude Code chat.",
  "version": "0.3.0",
  "publisher": "anton",
  "license": "MIT",
  "author": {
    "name": "Anton Dergunov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anton-dergunov/vscode-pdf-viewer.git"
  },
  "homepage": "https://github.com/anton-dergunov/vscode-pdf-viewer#readme",
  "bugs": {
    "url": "https://github.com/anton-dergunov/vscode-pdf-viewer/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "highlight",
    "annotation",
    "claude"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onOpenExternalUri:http",
    "onOpenExternalUri:https",
    "onUri"
  ],
  "enabledApiProposals": [
    "externalUriOpener"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscode-pdf-viewer.pdfEditor",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfViewer.open",
        "title": "Open PDF at a Page or Section",
        "category": "PDF Viewer"
      }
    ],
    "configuration": {
      "title": "PDF Viewer",
      "properties": {
        "pdfViewer.pdfRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder that relative paths in PDF links are resolved against, e.g. `~/Papers`. When empty, they are resolved against the first workspace folder."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p . && tsc -p src/webview",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=out/test --out-extension:.js=.mjs --log-level=warning && node --test out/test/*.mjs",
    "package": "vsce package",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.3.289",
    "typescript": "^7.0.2"
  }
}
