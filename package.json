{
  "name": "vscode-pdf-viewer",
  "displayName": "PDF Viewer Pro",
  "description": "Fast, feature-rich PDF Viewer with highlighting and annotation support for VS Code powered by PDF.js.",
  "version": "0.1.0",
  "publisher": "prototype",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "pdf-viewer",
    "highlight",
    "annotate",
    "pdfjs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscode-pdf-viewer.pdfEditor",
        "displayName": "PDF Viewer Pro",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vscode-pdf-viewer.open",
        "title": "PDF Viewer: Open PDF File",
        "category": "PDF Viewer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
