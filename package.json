{
  "name": "vscode-pdf-viewer",
  "displayName": "PDF Viewer",
  "description": "Minimal PDF viewer with highlighting and search.",
  "version": "0.3.0",
  "publisher": "anton",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "highlight"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onOpenExternalUri:http",
    "onOpenExternalUri:https",
    "onUri"
  ],
  "enabledApiProposals": [
    "externalUriOpener"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscode-pdf-viewer.pdfEditor",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfViewer.open",
        "title": "Open PDF at a Page or Section",
        "category": "PDF Viewer"
      }
    ],
    "configuration": {
      "title": "PDF Viewer",
      "properties": {
        "pdfViewer.pdfRoot": {
          "type": "string",
          "default": "~/Yandex.Disk.localized/Papers",
          "markdownDescription": "Folder that relative `file` paths in paper links are resolved against."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p . && tsc -p src/webview",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.3.289",
    "typescript": "^7.0.2"
  }
}
